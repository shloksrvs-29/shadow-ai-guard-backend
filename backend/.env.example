# Copy this file to .env and fill in real values before deploying.
# All variables are prefixed SAG_ (Shadow AI Guard) -- see app/config.py

SAG_ENVIRONMENT=development

# Comma-separated list is NOT supported directly by pydantic-settings list
# parsing from .env; easiest is to set via a JSON array string, e.g.:
SAG_API_KEYS=["dev-local-key-change-me","another-org-key"]

SAG_JWT_SECRET=replace-with-a-long-random-string
SAG_JWT_ALGORITHM=HS256
SAG_JWT_EXPIRY_MINUTES=60

# presidio (works today) or transformer (after you run scripts/train_ner.py)
SAG_NER_BACKEND=presidio
SAG_NER_MODEL_PATH=en_core_web_sm
SAG_TRANSFORMER_MODEL_PATH=./models/shadow-ner-finetuned
SAG_NER_SCORE_THRESHOLD=0.5

# low | medium | high -- minimum severity that triggers a BLOCK decision
SAG_BLOCK_ON_SEVERITY=medium

SAG_AUDIT_DB_PATH=./data/audit_log.db

# Restrict this in production to your actual extension ID(s), e.g.:
# ["chrome-extension://abcdefghijklmnopqrstuvwxyz123456"]
SAG_ALLOWED_ORIGINS=["*"]
